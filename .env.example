# Copy to .env for local development. Never commit .env.
DEBUG=1
SECRET_KEY=dev-only-change-me

# Leave unset locally to use SQLite. On Render, paste the Supabase "Session pooler" URL.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Leave both email options unset locally: emails are written to sent_emails/ instead.
# Production (Render blocks SMTP on free plans, so use Brevo's HTTPS API):
# BREVO_API_KEY=xkeysib-...
# Local alternative, real sending via Gmail SMTP:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=yourapp@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-app-password
# DEFAULT_FROM_EMAIL=coroutines <yourapp@gmail.com>
